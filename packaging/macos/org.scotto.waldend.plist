<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The launchd job for Walden's daemon, owned by the macOS package and installed
  at /Library/LaunchDaemons/org.scotto.waldend.plist. Walden loads, enables, and
  disables this job at runtime, but never writes or deletes it.

  Disabled: a fresh installation stays idle. `walden start` enables the job, and
  retirement disables it again, so the daemon runs only while a block does.

  KeepAlive/SuccessfulExit: launchd restarts the daemon if it dies, but treats
  the clean exit it makes after a completed block as final. This is the launchd
  spelling of the systemd unit's Restart=on-failure.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.scotto.waldend</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/waldend</string>
	</array>
	<key>Disabled</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>Nice</key>
	<integer>5</integer>
</dict>
</plist>
